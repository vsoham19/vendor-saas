{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "typeRoots": [
      "./node_modules/@types",
      "../backend/node_modules/@types",
      "../backend/src/types"
    ]
  },
  "ts-node": {
    "transpileOnly": true
  },
  "include": [
    "**/*.ts",
    "../backend/src/types/**/*.d.ts"
  ]
}
